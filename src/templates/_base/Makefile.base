# coding-os — Universal Make Targets
# Include this in your project Makefile: include .coding-os/Makefile.base
# Or copy to your project root.

.DEFAULT_GOAL := help

# ── Coding OS paths ─────────────────────────────────────────────────
# Override these if your coding-os is in a non-standard location.
# Portable resolution order:
#   1. Installed `cos` binary on PATH (preferred)
#   2. Adapter hook symlink back to the coding-os install
# This keeps consumer projects runnable outside the coding-os repo itself.
COS_HOOKS ?= $(shell if command -v cos >/dev/null 2>&1; then cos hooks-dir; elif [ -e .codex/hooks/cos-env.sh ]; then dirname "$$(realpath .codex/hooks/cos-env.sh)"; elif [ -e .claude/hooks/cos-env.sh ]; then dirname "$$(realpath .claude/hooks/cos-env.sh)"; fi)
COS_ROOT ?= $(shell dirname "$$(dirname "$(COS_HOOKS)")")
COS_SCRIPTS := $(COS_ROOT)/core/scripts

export COS_STATE_DIR ?= .coding-os
export COS_DB_PATH ?= $(COS_STATE_DIR)/coding-os.db
export COS_BRAIN_DIR ?= $(COS_ROOT)/core/thinking_os

# ── Session & Status ────────────────────────────────────────────────

.PHONY: session-init
session-init: ## Run ONCE per session: phase + recent changes + task summary
	@echo "=== Project Status ==="
	@echo ""
	@echo "=== Recent Changes (last 3) ==="
	@bash $(COS_SCRIPTS)/log-latest.sh --compact 3
	@echo ""
	@echo "=== Task Summary ==="
	@OPEN=$$(grep -c '\- \[ \]' docs/tasks.md 2>/dev/null; true); \
	WIP=$$(grep -c '\- \[/\]' docs/tasks.md 2>/dev/null; true); \
	DONE=$$(grep -c '\- \[x\]' docs/tasks.md 2>/dev/null; true); \
	BLOCKED=$$(grep -c '^- (BLOCKED:' docs/tasks.md 2>/dev/null; true); \
	echo "Open: $${OPEN:-0} | In-progress: $${WIP:-0} | Done: $${DONE:-0} | Blocked: $${BLOCKED:-0}"; \
	echo ""; \
	echo "Next 5 open:"; \
	grep '\- \[ \]' docs/tasks.md 2>/dev/null | head -5 | sed 's/^- \[ \] /  TODO: /' || echo "  (none)"
	@echo ""
	@echo "Next: make task-next"

# ── Task Management ─────────────────────────────────────────────────

.PHONY: task-next
task-next: ## Show next recommended task
	@cos task-pick

.PHONY: task-start
task-start: ## Start a task (TASK=043)
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-start TASK=<number>"; exit 1; fi
	@cos task-start TASK-$(TASK)

.PHONY: task-done
task-done: ## Mark a task done (TASK=043)
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-done TASK=<number>"; exit 1; fi
	@cos task-done TASK-$(TASK)

.PHONY: task-block
task-block: ## Block a task (TASK=024 REASON="why")
	@if [ -z "$(TASK)" ] || [ -z "$(REASON)" ]; then echo "Usage: make task-block TASK=<number> REASON=\"why it is blocked\""; exit 1; fi
	@cos task-block TASK-$(TASK) --reason "$(REASON)"

.PHONY: task-create
task-create: ## Create a new task — use the cos CLI directly
	@echo "Create tasks with the cos CLI (it needs the required --swimlane / --kind flags):"
	@echo "  cos task-create --title \"...\" --swimlane <lane> --kind <feature|bug|chore|spike|docs|refactor|test|security>"

.PHONY: task-context
task-context: ## Show task content + frontmatter (TASK=043) — alias for task-show
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-context TASK=<number>"; exit 1; fi
	@cos task-show TASK-$(TASK)

.PHONY: task-show
task-show: ## Show task content + frontmatter (TASK=043)
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-show TASK=<number>"; exit 1; fi
	@cos task-show TASK-$(TASK)

.PHONY: task-list
task-list: ## Show tasks (STATUS=open|wip|blocked|done|all)
	@cos board

# ── Scrumban board (Phase L) ──────────────────────────────────────
# These thin wrappers delegate to the `cos` CLI (cli/board_commands.py).
# They exist for muscle-memory parity with the legacy `make task-*`
# commands above — agents and humans can keep using either.

.PHONY: board
board: ## Show the Scrumban board (ASCII). Use `cos board --web` for browser.
	@cos board

.PHONY: board-web
board-web: ## Open the web Scrumban board at http://127.0.0.1:9000
	@cos board --web

.PHONY: daily
daily: ## Daily standup summary (yesterday + today candidates + blockers)
	@cos daily

.PHONY: retro
retro: ## Weekly retro — throughput + cycle time + emergency count
	@cos retro

.PHONY: wip
wip: ## Current WIP counts vs caps from scrumban-config.yaml
	@cos wip

.PHONY: task-pick
task-pick: ## Print top candidate tasks to work on next
	@cos task-pick

.PHONY: task-cancel
task-cancel: ## Cancel a task (TASK=043)
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-cancel TASK=<number>"; exit 1; fi
	@cos task-cancel TASK-$(TASK)

.PHONY: task-log
task-log: ## Show a task's Work Log (TASK=043)
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-log TASK=<number>"; exit 1; fi
	@cos task-log TASK-$(TASK)

.PHONY: task-history
task-history: ## Show task status transitions (TASK=043)
	@if [ -z "$(TASK)" ]; then echo "Usage: make task-history TASK=<number>"; exit 1; fi
	@cos task-history TASK-$(TASK)

.PHONY: task-validate
task-validate: ## Lint all docs/tasks/*.md against the lean frontmatter schema
	@cos task-validate

# ── Logging ─────────────────────────────────────────────────────────

.PHONY: log-latest
log-latest: ## Show last N log entries (N=5)
	@bash $(COS_SCRIPTS)/log-latest.sh "$(or $(N),1)"

.PHONY: log-write
log-write: ## Write structured log entry (TYPE+MSG+WHAT+FILES)
	@if [ -z "$(TYPE)" ] || [ -z "$(MSG)" ]; then echo "Usage: make log-write [TASK=###] TYPE=<type> MSG=\"title\" [WHAT=\"impact\"] [FILES=\"files\"]"; exit 1; fi
	@bash $(COS_SCRIPTS)/log-write.sh "$(TASK)" "$(TYPE)" "$(MSG)" "$(WHAT)" "$(FILES)"

.PHONY: log-search
log-search: ## Search changes.log (QUERY="stripe")
	@if [ -z "$(QUERY)" ]; then echo "Usage: make log-search QUERY=\"search term\" [N=10]"; exit 1; fi
	@bash $(COS_SCRIPTS)/log-search.sh "$(QUERY)" "$(or $(N),10)"

# ── Docs ────────────────────────────────────────────────────────────

.PHONY: docs-index
docs-index: ## Index docs/ for RAG retrieval (incremental, mtime-aware)
	@cos docs-index --project-dir $(CURDIR)

.PHONY: docs-reindex
docs-reindex: ## Force full re-index of docs/ (after model upgrade)
	@cos docs-index --project-dir $(CURDIR) --force

.PHONY: task-sync
task-sync: ## Sync docs/tasks/*.md → coding-os.db (Phase C incremental)
	@cos task-sync --project-dir $(CURDIR)

.PHONY: task-resync
task-resync: ## Force full re-sync of every task file (after schema or parser change)
	@cos task-sync --project-dir $(CURDIR) --force

# Skip in meta-repo (COS_META_REPO=1) — the meta Makefile provides a richer
# docs-lint that runs link audit + frontmatter. Without this guard GNU make
# warns "overriding commands for target `docs-lint'" on every invocation.
ifndef COS_META_REPO
.PHONY: docs-lint
docs-lint: ## Lint markdown files in docs/ for SSOT contract compliance
	@bash $(COS_SCRIPTS)/docs-lint.sh
endif

.PHONY: docs-nav-fix
docs-nav-fix: ## Auto-add missing > Nav: breadcrumbs in docs/
	@bash $(COS_SCRIPTS)/docs-nav-fix.sh

.PHONY: docs-nav-check
docs-nav-check: ## Report missing Nav breadcrumbs without modifying files
	@bash $(COS_SCRIPTS)/docs-nav-fix.sh --check

.PHONY: ref
ref: ## Resolve REF code to file path (REF=PLAYBOOK-BACKEND [READ=1])
	@if [ -n "$(READ)" ]; then \
	  bash $(COS_SCRIPTS)/ref-resolve.sh "$(REF)" --read; \
	else \
	  bash $(COS_SCRIPTS)/ref-resolve.sh "$(REF)"; \
	fi

# ── Hooks & Health ──────────────────────────────────────────────────

.PHONY: verify-hooks
verify-hooks: ## Syntax-check + shellcheck (warning level) on all hook scripts
	@FAIL=0; for f in $(COS_HOOKS)/*.sh; do bash -n "$$f" 2>&1 || FAIL=1; done; \
	if [ $$FAIL -eq 1 ]; then echo "ERROR: Hook syntax errors found" >&2; exit 1; \
	else echo "OK: All hooks pass syntax check"; fi
	@if command -v shellcheck >/dev/null 2>&1; then \
	  if shellcheck -S warning $(COS_HOOKS)/*.sh; then \
	    echo "OK: shellcheck (warning level) clean"; \
	  else \
	    echo "ERROR: shellcheck warnings found" >&2; exit 1; \
	  fi; \
	else \
	  echo "WARN: shellcheck not installed — install with 'brew install shellcheck' to enforce" >&2; \
	fi
	@MISSING=""; for f in $(COS_HOOKS)/block-*.sh; do \
	  [ -e "$$f" ] || continue; \
	  grep -q 'exit 2' "$$f" || MISSING="$$MISSING $$(basename $$f)"; \
	done; \
	if [ -n "$$MISSING" ]; then \
	  echo "ERROR: block-* hook(s) missing 'exit 2' (enforcement disarmed):$$MISSING" >&2; exit 1; \
	else echo "OK: all block-* hooks contain 'exit 2'"; fi

.PHONY: cos-reindex
cos-reindex: ## Re-embed all observations/patterns/outcomes (Phase B RAG)
	@cos reindex --project-dir $(CURDIR) 2>&1 | tail -20

.PHONY: cos-download-model
cos-download-model: ## Pre-download the embedding model so first run is fast
	@uv run --extra rag --directory $(COS_ROOT) python -c "import sys; sys.path.insert(0, '$(COS_ROOT)/core/thinking_os'); from embeddings import _get_model; m = _get_model(); print('OK: embedding model loaded' if m else 'WARN: model unavailable')"

.PHONY: cos-health
cos-health: ## Run coding-os health check
	@echo "=== Coding OS Health ===" && \
	echo "State dir: $(COS_STATE_DIR)" && \
	echo "DB path:   $(COS_DB_PATH)" && \
	if [ -f "$(COS_DB_PATH)" ]; then \
	  echo "DB size:   $$(du -h "$(COS_DB_PATH)" | cut -f1)"; \
	else echo "DB:        not initialized"; fi && \
	echo "Hooks:     $$(ls $(COS_HOOKS)/*.sh 2>/dev/null | wc -l | tr -d ' ') scripts"

.PHONY: doctor
doctor: ## Deep health check: scaffold, DB schema, adapter, MCP, cron (cos doctor)
	@cos doctor --project-dir $(CURDIR)

# ── Hub (web UI + REST API) ──────────────────────────────────────────

.PHONY: hub-start
hub-start: ## Start the coding-os Hub daemon (port 9188 by default)
	@cos hub start

.PHONY: hub-stop
hub-stop: ## Stop the Hub daemon
	@cos hub stop

.PHONY: hub-status
hub-status: ## Show Hub daemon status + registered projects
	@cos hub status

# ── Verification (override in project Makefile) ─────────────────────

ifndef COS_META_REPO
.PHONY: verify
verify: ## Run verification for a domain (DOMAIN=backend|frontend|docs|full)
	@echo "No verification targets defined. Add your own in the project Makefile."
	@echo "Example:"
	@echo "  verify:"
	@echo "    make lint && make test"
endif

# ── Phase M fast smoke (safe-test) ─────────────────────────────────

.PHONY: safe-test
safe-test: ## Fast smoke for thinking_os + graph_os + Phase M (≤30s, no network)
	uv run --extra rag pytest -q \
	  core/thinking_os/tests/test_db.py \
	  core/thinking_os/tests/test_cognition_schemas.py \
	  core/thinking_os/tests/test_cognition_supervisor.py \
	  core/thinking_os/tests/test_cognition_tools.py \
	  core/graph_os/tests/test_backend_factory.py \
	  core/graph_os/tests/test_determinism.py \
	  core/graph_os/tests/test_backend_parity.py \
	  tests/test_hooks_phase_m.py \
	  tests/test_codex_formula_commands.py

# ── Nightly maintenance (CRON A) ────────────────────────────────────

COS_CRON_HOUR ?= 3

ifndef COS_META_REPO
.PHONY: cron-install
cron-install: ## Install nightly launchd job (macOS) — daily decay + learn
	cos cron install --hour $(COS_CRON_HOUR)

.PHONY: cron-uninstall
cron-uninstall: ## Unload + remove nightly launchd job
	cos cron uninstall

.PHONY: cron-run
cron-run: ## Run nightly maintenance now (dry-run safe to test)
	cos cron run --verbose

.PHONY: cron-status
cron-status: ## Show last nightly run summary + plist status
	cos cron status
endif

# ── Knowledge Graph (graph_os) ──────────────────────────────────────

.PHONY: graph-reindex
graph-reindex: ## Index codebase into the knowledge graph (incremental)
	@cos graph-reindex

.PHONY: graph-query
graph-query: ## Semantic symbol search (QUERY="find all auth handlers")
	@if [ -z "$(QUERY)" ]; then echo "Usage: make graph-query QUERY=\"...\""; exit 1; fi
	@cos graph-query "$(QUERY)"

.PHONY: graph-context
graph-context: ## Callers + callees for a symbol (SYM=function_name)
	@if [ -z "$(SYM)" ]; then echo "Usage: make graph-context SYM=<symbol>"; exit 1; fi
	@cos graph-context "$(SYM)"

.PHONY: graph-impact
graph-impact: ## Blast-radius risk analysis for a symbol (SYM=function_name)
	@if [ -z "$(SYM)" ]; then echo "Usage: make graph-impact SYM=<symbol>"; exit 1; fi
	@cos graph-impact "$(SYM)"

.PHONY: graph-contracts
graph-contracts: ## List all HTTP / MCP / gRPC / event handlers in the codebase
	@cos graph-contracts

.PHONY: graph-entrypoints
graph-entrypoints: ## Rank and show main / cli / http / cron / test entry points
	@cos graph-entrypoints

.PHONY: graph-communities
graph-communities: ## Detect Louvain communities (logical module groups)
	@cos graph-communities

.PHONY: graph-export
graph-export: ## Export the graph (FORMAT=json|mermaid|dot, default json)
	@cos graph-export $(if $(FORMAT),--format $(FORMAT),)

.PHONY: graph-stats
graph-stats: ## Show knowledge graph DB statistics
	@cos graph-stats

# ── Help ────────────────────────────────────────────────────────────

.PHONY: help
help: ## Show all commands
	@echo "=== coding-os Commands ==="
	@echo ""
	@echo "Session:   make session-init"
	@echo "Tasks:     make task-start TASK=### | task-done ... | task-block ... | task-cancel ... | task-show ..."
	@echo "Board:     make board | daily | retro | wip | task-pick | task-validate"
	@echo "Graph:     make graph-reindex | graph-query QUERY=... | graph-context SYM=... | graph-impact SYM=..."
	@echo "Logging:   make log-latest [N=5] | log-write TYPE=... MSG=... | log-search QUERY=..."
	@echo "Health:    make doctor | cos-health | verify-hooks | hub-start | hub-status"
	@echo "Cron:      make cron-install | cron-run | cron-status"
	@echo ""
	@echo "All targets:"
	@grep -E '^[a-zA-Z_-]+:.*##' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*## "}; {printf "  %-22s %s\n", $$1, $$2}'
