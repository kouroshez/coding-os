{
  "name": "{{PROJECT_NAME}}/backend",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.61.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "larastan/larastan": "^3.0"
  },
  "scripts": {
    "lint": "phpstan analyse app routes --level=6",
    "test": "phpunit"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
