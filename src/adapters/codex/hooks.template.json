{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-pretool-dispatch.sh\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-preedit-dispatch.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_task_move",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/inject-mcp-caller-session.sh\"",
            "statusMessage": "🪪 Attributing task move to this panel...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_task_create",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/inject-mcp-caller-session.sh\"",
            "statusMessage": "🪪 Attributing task create to this panel...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_work_log_append",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/inject-mcp-caller-session.sh\"",
            "statusMessage": "🪪 Attributing work-log to this panel...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/enforce-graph-first-read.sh\"",
            "statusMessage": "🧭 Checking graph-first discipline before Read...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/nudge-task-discovery.sh\"",
            "statusMessage": "🗂️ Suggesting cos task-show over a docs/tasks Read...",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-posttool-dispatch.sh\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-postedit-dispatch.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_task_move",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/sync-task-current.sh\"",
            "statusMessage": "📌 Syncing .task-current...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_backtrack_log",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/track-backtrack.sh\"",
            "statusMessage": "↩️ Backtrack counter updated...",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-sessionstart-dispatch.sh\"",
            "statusMessage": "🚀 Loading session context + MCP health..."
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-sessionstart-dispatch.sh\"",
            "statusMessage": "🔄 Recovering workflow context + MCP health..."
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-sessionstart-dispatch.sh\"",
            "statusMessage": "Loading clean session context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-userpromptsubmit-dispatch.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-stop-dispatch.sh\"",
            "statusMessage": "📝 Finalizing session recap + memory enrichment...",
            "timeout": 5000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/agent-presence.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/agent-presence.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=codex \"{{HOOKS_DIR}}/codex-sessionend-dispatch.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
