{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/cursor-pretool-dispatch.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/cursor-pretool-write-dispatch.sh",
            "statusMessage": "🧷 Running write/edit enforcement chain..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-rename-plan.sh",
            "statusMessage": "✏️  Verifying rename-plan marker...",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-doc-sync.sh",
            "statusMessage": "📚 Scanning related docs for drift...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/capture-observation.sh",
            "statusMessage": "🧠 Recording observation + embedding to memory...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/capture-work-log.sh",
            "statusMessage": "📝 Appending Work Log entry...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/cursor-posttool-write-dispatch.sh",
            "statusMessage": "📎 Post-write observability + reminders..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/remind-learn-validate.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/verify-rename-callers.sh",
            "statusMessage": "🔁 Checking for unreplaced rename callers...",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/track-skill.sh",
            "statusMessage": "🛠️ Tracking skill invocation...",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/cursor-sessionstart-dispatch.sh",
            "statusMessage": "🚀 Loading session context + MCP health..."
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/remind-daily.sh",
            "statusMessage": "🗓️  Checking daily check-in recency...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/cursor-sessionstart-dispatch.sh",
            "statusMessage": "🔄 Recovering workflow context + MCP health..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-context.sh",
            "statusMessage": "🔄 Checking workflow state...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-thinking-os.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/classify-task-mode.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-graph-os.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-docs-first.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/detect-exhaustive-intent.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/cursor-stop-dispatch.sh",
            "statusMessage": "📝 Finalizing session recap + memory enrichment...",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
