{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-secrets.sh",
            "statusMessage": "🔒 Scanning command for credentials...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-dangerous-commands.sh",
            "statusMessage": "🛡️ Checking command safety (rm, force-push, reset)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-uv-heredoc.sh",
            "statusMessage": "⚠️ Inspecting uv-run heredoc pattern (rule #9)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/branch-guard.sh",
            "statusMessage": "🌳 Enforcing trunk-based workflow (no branches)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-commit-message.sh",
            "statusMessage": "📝 Validating commit message contract...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-verify.sh",
            "statusMessage": "✅ Verifying suites before task-done...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/test-governor.sh",
            "statusMessage": "🧪 Test-governor: dedup/lock/sweep check...",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-diff-size.sh",
            "statusMessage": "📏 Checking staged diff size...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/search-enforce-inventory.sh",
            "statusMessage": "🔎 Running search inventory before bulk replace...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-task-discovery.sh",
            "statusMessage": "🗂️ Suggesting cos task-show over docs/tasks read...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-secrets.sh",
            "statusMessage": "🔒 Scanning file content for credentials...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-bad-patterns.sh",
            "statusMessage": "🚫 Checking for anti-patterns (bare except: pass, …)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-protected-files.sh",
            "statusMessage": "🔐 Checking protected governance files...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-task-transition.sh",
            "statusMessage": "🚦 Checking task status transition...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-migration-conflict.sh",
            "statusMessage": "🗃️ Checking migration version conflicts (rule #10)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-hardcoded-literals.sh",
            "statusMessage": "🎯 Scanning cli/*.py for hardcoded literals (rule #12)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/validate-task-frontmatter.sh",
            "statusMessage": "🧾 Validating task frontmatter...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-wip-limit.sh",
            "statusMessage": "🚦 Checking WIP limit before status change...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-template.sh",
            "statusMessage": "📋 Checking doc templates (task / ADR / PRD / insight)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/thinking_os-gate.sh",
            "statusMessage": "🧠 Verifying Complexity Gate recorded...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-scaffold-boundary.sh",
            "statusMessage": "🚧 Checking scaffold-boundary (multi-stack subtree isolation)...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-task-start.sh",
            "statusMessage": "📌 Verifying active task...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-doc-anchor.sh",
            "statusMessage": "📎 Verifying doc anchor (docs-first principle)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-memory-check.sh",
            "statusMessage": "🔎 Verifying Memory Check (cos_search) recorded...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-skill.sh",
            "statusMessage": "🛠️ Verifying domain skill invoked...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-zoom.sh",
            "statusMessage": "🔍 Verifying Plan checkpoint for COMPLICATED+...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-graph-context.sh",
            "statusMessage": "🧭 Verifying graph-context marker for load-bearing file...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-task-body.sh",
            "statusMessage": "🚦 Validating transition gates (DoR/DoD)...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-anti-ambiguity.sh",
            "statusMessage": "🔍 Anti-Ambiguity gate check...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/jit-recall.sh",
            "statusMessage": "🧠 Checking for a past lesson on this file...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_task_move",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/inject-mcp-caller-session.sh",
            "statusMessage": "🪪 Attributing task move to this panel...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_task_create",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/inject-mcp-caller-session.sh",
            "statusMessage": "🪪 Attributing task create to this panel...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_work_log_append",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/inject-mcp-caller-session.sh",
            "statusMessage": "🪪 Attributing work-log to this panel...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/block-shared-tree-edit.sh",
            "statusMessage": "🌳 pr-mode: enforcing worktree edit isolation...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-destructive-edit.sh",
            "statusMessage": "🛡️ Checking for destructive deletion of load-bearing content...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-graph-first-read.sh",
            "statusMessage": "🧭 Checking graph-first discipline before Read...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-task-discovery.sh",
            "statusMessage": "🗂️ Suggesting cos task-show over a docs/tasks Read...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-rename-plan.sh",
            "statusMessage": "✏️  Verifying rename-plan marker...",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/search-verify-remaining.sh",
            "statusMessage": "✅ Verifying 0 matches remain after replace...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/advance-role.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/sync-task-current.sh",
            "statusMessage": "📌 Syncing .task-current...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-graph-reconcile-shell.sh",
            "statusMessage": "🔁 Reconciling graph for shell file op (prune + reindex)...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/record-verify-auto.sh",
            "statusMessage": "🧾 Recording verify-suite result...",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/link-commit-to-task.sh",
            "statusMessage": "🔗 Linking commit to task...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/remind-learn-validate.sh",
            "statusMessage": "💡 Checking if learn-validate reminder is due...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/enforce-doc-sync.sh",
            "statusMessage": "📚 Scanning related docs for drift...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/advance-role.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/capture-observation.sh",
            "statusMessage": "🧠 Recording observation + embedding to memory...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/capture-work-log.sh",
            "statusMessage": "📝 Appending Work Log entry...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/lint-task.sh",
            "statusMessage": "📏 Lint task (Rule 15)...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/track-discovery.sh",
            "statusMessage": "🔍 Scanning for discoveries...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-reindex-docs.sh",
            "statusMessage": "♻️ Re-indexing doc/code for cos_doc_search + graph_os freshness...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-regen-doc-index.sh",
            "statusMessage": "📑 Regenerating affected docs/<dir>/00-index.md from frontmatter...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-task-sync.sh",
            "statusMessage": "♻️ Re-syncing task to DB...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-reuse-first.sh",
            "statusMessage": "♻️ Checking cross-service reuse (src/shared/ nudge)...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/check-doc-size.sh",
            "statusMessage": "📐 Checking doc size budget...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/regen-reminder.sh",
            "statusMessage": "🔄 Checking if derived artifacts need regeneration...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/test-first-reminder.sh",
            "statusMessage": "🧪 Checking for companion test file...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/check-agents-md-size.sh",
            "statusMessage": "📏 Checking AGENTS.md size (Codex 32 KiB cap)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/check-agents-md-refs.sh",
            "statusMessage": "🔗 Checking AGENTS.md path references are alive...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/remind-dogfood.sh",
            "statusMessage": "🧬 Checking if meta-project dogfood refresh is needed...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/verify-rename-callers.sh",
            "statusMessage": "🔁 Checking for unreplaced rename callers...",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_task_move",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/sync-task-current.sh",
            "statusMessage": "📌 Syncing .task-current...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/track-skill.sh",
            "statusMessage": "🛠️ Tracking skill invocation...",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__coding-os__cos_backtrack_log",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/track-backtrack.sh",
            "statusMessage": "↩️ Backtrack counter updated...",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/record-verify-auto.sh",
            "statusMessage": "🧾 Recording failed suite result...",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/capture-tool-failure.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/check-mcp-extras.sh",
            "statusMessage": "🔌 Checking MCP extras health...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-skill-primer.sh",
            "statusMessage": "🧠 Priming required-skill card...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/rules-primer.sh",
            "statusMessage": "📋 Priming workflow-integrity rules card...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/remind-daily.sh",
            "statusMessage": "🗓️  Checking daily check-in recency...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/ensure-hub-up.sh",
            "statusMessage": "🛰️  Ensuring Coding OS Hub is up...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-context.sh",
            "statusMessage": "🚀 Loading session context + memory digest...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-mcp-down.sh",
            "statusMessage": "🩺 Probing MCP coding-os liveness...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-brain-decay.sh",
            "statusMessage": "📉 Debounced pattern-decay sweep...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/reclaim-sweep.sh",
            "statusMessage": "♻️  Reclaiming zombie tasks of dead sessions...",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-graph-empty.sh",
            "statusMessage": "🕸️  Checking graph_os index state...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/ensure-agent-memory-link.sh",
            "statusMessage": "🔗 Linking versioned agent memory...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/remind-daily.sh",
            "statusMessage": "🗓️  Checking daily check-in recency...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/ensure-agent-memory-link.sh",
            "statusMessage": "🔗 Re-checking agent memory link...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/pr-reap.sh",
            "statusMessage": "🌳 pr-mode: reaping orphaned worktrees...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-skill-primer.sh",
            "statusMessage": "🧠 Re-priming required-skill card...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/rules-primer.sh",
            "statusMessage": "📋 Re-priming workflow-integrity rules card...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-context.sh",
            "statusMessage": "🔄 Recovering workflow context + memory digest...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-mcp-down.sh",
            "statusMessage": "🩺 Probing MCP coding-os liveness...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-brain-decay.sh",
            "statusMessage": "📉 Debounced pattern-decay sweep...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/reclaim-sweep.sh",
            "statusMessage": "♻️  Reclaiming zombie tasks of dead sessions...",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-graph-empty.sh",
            "statusMessage": "🕸️  Checking graph_os index state...",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-thinking-os.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-compose-roles.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/classify-task-mode.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-graph-os.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-model-routing.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-git-mode.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-task-discovery.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-docs-first.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-context.sh",
            "statusMessage": "🔄 Checking workflow state...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-reentry.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/drain-embedding-outbox.sh",
            "statusMessage": "🧮 Draining deferred embeddings...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/session-end.sh",
            "statusMessage": "📝 Writing turn summary + enrichment to memory...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/warn-abandoned-task.sh",
            "statusMessage": "🩹 Checking for tasks left in_progress...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/check-capture-worked.sh",
            "statusMessage": "📊 Session recap: verifying observations captured...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/auto-trace-rotate.sh",
            "statusMessage": "🧹 Rotating old trace files...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/snapshot-transcript.sh",
            "statusMessage": "📑 Snapshotting session transcript...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/sync-agent-memory.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/nudge-learn-narrative.sh",
            "statusMessage": "🧠 Checking if a lesson is worth recording...",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_DIR}}/agent-presence.sh",
