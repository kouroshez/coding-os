<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  coding-os nightly maintenance job.
  Generated by: make cron-install
  Source:       core/scheduled/launchd/com.codingos.nightly.plist.template

  Placeholders (replaced by make cron-install):
    {{CODING_OS_ROOT}}   absolute path to the coding-os repo
    {{UV_PATH}}          absolute path to the uv binary
    {{HOME}}             user home directory
    {{PATH}}             runtime PATH from make environment
    {{CRON_HOUR}}        hour to run (0-23, default 3)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codingos.nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{UV_PATH}}</string>
    <string>run</string>
    <string>--project</string>
    <string>{{CODING_OS_ROOT}}</string>
    <string>python</string>
    <string>{{CODING_OS_ROOT}}/core/scheduled/nightly.py</string>
  </array>

  <!-- Run daily at {{CRON_HOUR}}:00 local time.
       launchd fires the missed run automatically if the machine was asleep. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>{{CRON_HOUR}}</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>{{HOME}}/.coding-os/scheduled/nightly-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>{{HOME}}/.coding-os/scheduled/nightly-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>

  <!-- Throttle: don't re-run within 60s if launchd retries -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
