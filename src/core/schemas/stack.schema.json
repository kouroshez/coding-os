{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-os.dev/schemas/stack.schema.json",
  "title": "Coding-OS Stack Manifest",
  "description": "Schema for templates/<id>/stack.yaml. Defines a stack module — metadata, contributed substitutions, ref codes, routing, rules, dimensions, skill enforcement, Makefile targets, and Jinja fragments.",
  "type": "object",
  "required": ["version", "id", "label", "category", "language"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version. Currently fixed at 1."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Lowercase identifier. Must match the directory name under templates/."
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Base programming language (python, typescript, go, …). Drives language-grouped discovery; picking a bare language resolves to the '<language>-plain' stack (TASK-348)."
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "Optional parent stack id. Child wins on scalars; substitutions merge parent-first; list fields concatenate with dedup. Cycles/unknown parents skip the stack with a WARN."
    },
    "structure": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "description": "Canonical directory anatomy this stack owns (docs/engineering/project-anatomy.md, TASK-351). When two selected stacks share the same root, init relocates each to src/services/<stack-id>/.",
      "properties": {
        "root": {"type": "string", "description": "Subtree this stack writes into (e.g. src/backend)."},
        "tree": {"type": "string", "description": "Canonical inner layout, human-readable tree text."},
        "notes": {"type": "string", "description": "Convention rationale / coexistence caveats."}
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable stack name (e.g. 'Django + DRF + PostgreSQL')."
    },
    "category": {
      "type": "string",
      "enum": ["backend", "frontend", "library", "devops", "data", "mobile"],
      "description": "Stack category. Doctor C12 warns when two stacks share a category."
    },
    "primary_skill": {
      "type": ["string", "null"],
      "description": "Primary skill name invoked when editing files matching this stack."
    },
    "skills": {
      "type": "array",
      "items": {"type": "string"},
      "description": "All skills this stack contributes (including primary)."
    },
    "substitutions": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Template substitution keys merged into the aggregated world. Stack values override base defaults. Required keys depend on `category` (enforced by root-level allOf): backend/frontend/mobile must contribute routing + verify keys. Library/devops/data stacks may omit routing."
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["glob", "suites", "cmd"],
        "additionalProperties": false,
        "properties": {
          "glob": {"type": "string"},
          "suites": {"type": "string"},
          "cmd": {"type": "string"}
        }
      }
    },
    "routing_entries": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ref_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "path", "desc"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^REF:[A-Z0-9_-]+$"},
          "path": {"type": "string"},
          "desc": {"type": "string"}
        }
      }
    },
    "makefile_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cmd"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "cmd": {"type": "string"},
          "help": {"type": "string"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string"},
          "globs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "always_load": {"type": "boolean"},
          "priority": {"type": "integer"}
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "read_files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "depth": {"type": "string", "enum": ["L", "M", "D"]}
        }
      }
    },
    "skill_enforcement": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["primary"],
        "additionalProperties": false,
        "properties": {
          "globs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "primary": {"type": "string"},
          "secondary": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "agents_md_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "template"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "order": {"type": "integer"},
          "template": {"type": "string"}
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "command"],
        "additionalProperties": false,
        "properties": {
          "event": {"type": "string"},
          "matcher": {"type": "string"},
          "command": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Backend stacks must contribute routing + backend verify substitutions.",
      "if": {"properties": {"category": {"const": "backend"}}, "required": ["category"]},
      "then": {
        "properties": {
          "substitutions": {
            "required": [
              "DOMAIN_ROUTES",
              "SKILL_ROUTES",
              "ENGINEERING_RULE_ROUTING",
              "TOOL_ROUTING_IMPL",
              "QUICK_ROUTING",
              "STACK_REF_CODES",
              "VERIFY_BACKEND_GLOB",
              "VERIFY_BACKEND_SUITES",
              "VERIFY_BACKEND"
            ]
          }
        },
        "required": ["substitutions"]
      }
    },
    {
      "$comment": "Frontend stacks must contribute routing + frontend verify substitutions.",
      "if": {"properties": {"category": {"const": "frontend"}}, "required": ["category"]},
      "then": {
        "properties": {
          "substitutions": {
            "required": [
              "DOMAIN_ROUTES",
              "SKILL_ROUTES",
              "ENGINEERING_RULE_ROUTING",
              "TOOL_ROUTING_IMPL",
              "QUICK_ROUTING",
              "STACK_REF_CODES",
              "VERIFY_FRONTEND_GLOB",
              "VERIFY_FRONTEND_SUITES",
              "VERIFY_FRONTEND"
            ]
          }
        },
        "required": ["substitutions"]
      }
    },
    {
      "$comment": "Mobile stacks must contribute routing + mobile verify substitutions.",
      "if": {"properties": {"category": {"const": "mobile"}}, "required": ["category"]},
      "then": {
        "properties": {
          "substitutions": {
            "required": [
              "DOMAIN_ROUTES",
              "SKILL_ROUTES",
              "ENGINEERING_RULE_ROUTING",
              "TOOL_ROUTING_IMPL",
              "QUICK_ROUTING",
              "STACK_REF_CODES",
              "VERIFY_MOBILE_GLOB",
              "VERIFY_MOBILE_SUITES",
              "VERIFY_MOBILE"
            ]
          }
        },
        "required": ["substitutions"]
      }
    }
  ]
}
