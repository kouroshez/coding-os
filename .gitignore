# =====================================================================
# coding-os — .gitignore
# Industry standard: Python + Node.js + adapter-generated state.
# Keep alphabetical within sections; add a comment for non-obvious entries.
# =====================================================================

# ---- Python ----------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.tox/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
coverage.xml
.coverage
.coverage.*

# uv lockfile is intentionally NOT committed for libraries; flip if this becomes an app.
uv.lock

# ---- Node / web UI ---------------------------------------------------
# Any nested node_modules anywhere in the tree.
node_modules/
# Vite / Next.js / typical SPA build artifacts.
src/core/web/ui/dist/
src/core/web/ui/.vite/
src/core/web/ui/coverage/
src/core/web/ui/playwright-report/
src/core/web/ui/test-results/

# ---- Secrets / env ---------------------------------------------------
# Never commit env files. .env.example IS tracked (see negation below).
.env
.env.*
!.env.example
*.pem
*.key

# ---- Databases (project-local, not the coding-os repo itself) --------
*.db
*.db-shm
*.db-wal
*.db.backup-*

# ---- IDE / editor ----------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- coding-os runtime state ----------------------------------------
# Session-scoped + project-local — generated, never source of truth.
.coding-os/
# Exception: scaffold templates inside src/templates/<stack>/ ARE the
# SSOT for what `cos init` writes into a consumer project. Track them.
!src/templates/*/scaffold/.coding-os/
!src/templates/*/scaffold/.coding-os/**
# Exception: the meta-repo's OWN board config is real project structure
# (swimlanes board_os/graph_os/thinking_os). The test suite asserts its
# invariants, so it must exist on a fresh CI checkout — track this one
# file (the rest of .coding-os/ stays runtime junk and stays ignored).
!.coding-os/scrumban-config.yaml

# ---- Adapter-generated output (live symlinks into src/core/) --------
.claude/
.codex/
.mcp.json
changes.log

# Golden test fixtures are committed snapshots, not live output — the bare
# .claude//.codex/ rules above would otherwise leave their adapter
# subdirs untracked, so they drift per-machine and break test_golden_parity.
!tests/golden/**/.claude/
!tests/golden/**/.codex/
!tests/golden/**/.mcp.json

# ---- Playwright + screenshots ---------------------------------------
.playwright-mcp/
# Ad-hoc hub screenshots captured during UX hardening sessions.
# Promote to tests/e2e/__screenshots__/ when they need to be kept.
/hub-*.png

# ---- Operational outputs (sandboxes, snapshots, reports) -------------
.build/

# ---- Local dev scaffolds --------------------------------------------
test-codeos/

# ---- Logs -----------------------------------------------------------
*.log
# Exception: changes.log is a SEEDED starter file `cos init` writes into the
# consumer (tests/test_cli.py::test_creates_scaffold_files + doctor's
# scaffold.manifest_fresh assert it exists). The *.log rule above must not
# swallow the committed template source or its golden snapshots, or a clean
# CI checkout can't ship it.
!src/templates/*/scaffold/changes.log
!tests/golden/**/changes.log
