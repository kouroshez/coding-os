# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/

# Database (project-local, not part of coding-os repo)
*.db
*.db-shm
*.db-wal
*.db.backup-*

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# State files (session-scoped)
.coding-os/
# Exception: scaffold templates inside templates/<stack>/ ARE the SSOT
# for what `cos init` writes into a consumer project. Track them.
!templates/*/scaffold/.coding-os/
!templates/*/scaffold/.coding-os/**

# Adapter output (generated by coding-os init, symlinks to core/)
.claude/
.codex/
.cursor/
.mcp.json
changes.log

# uv
uv.lock

# pytest
.pytest_cache/

# Operational evaluation outputs (sandboxes, logs, snapshots, reports)
.build/

# Test scaffold for development
test-codeos/

# S5 web SPA build artifacts (sources live in core/web/ui/src/).
core/web/ui/node_modules/
core/web/ui/dist/
