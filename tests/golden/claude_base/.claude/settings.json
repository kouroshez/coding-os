            "timeout": 30
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce-wip-limit.sh\"",
            "statusMessage": "🚦 Checking WIP limit before status change...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce-template.sh\"",
            "statusMessage": "📋 Checking doc templates (task / ADR / PRD / insight)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/thinking_os-gate.sh\"",
            "statusMessage": "🧠 Verifying Complexity Gate recorded...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce-scaffold-boundary.sh\"",
