            "timeout": 10
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce-verify.sh\"",
            "statusMessage": "✅ Verifying suites before task-done...",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/test-governor.sh\"",
