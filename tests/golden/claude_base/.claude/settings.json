          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-secrets.sh\"",
            "statusMessage": "🔒 Scanning command for credentials...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-dangerous-commands.sh\"",
            "statusMessage": "🛡️ Checking command safety (rm, force-push, reset)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-uv-heredoc.sh\"",
            "statusMessage": "⚠️ Inspecting uv-run heredoc pattern (rule #9)...",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/branch-guard.sh\"",
