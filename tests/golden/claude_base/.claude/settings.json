            "timeout": 30
          },
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/nudge-task-discovery.sh\"",
            "statusMessage": "🗂️ Suggesting cos task-show over docs/tasks read...",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "env COS_AGENT=claude \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-secrets.sh\"",
            "statusMessage": "🔒 Scanning file content for credentials...",
            "timeout": 5
