# coding-os configuration
# Generated by: coding-os init
version: "1.0"

# Installed agent adapters
agents: []

# Stack templates applied
templates: []

# State directory for session files, gate, etc.
state_dir: .coding-os

# Code file extensions to enforce gates on
code_extensions: [py, ts, tsx, js, jsx, go, rs, java, kt, rb, php]

# Domain verification commands
verify: {}
#  backend: "make lint-backend && make test-backend"
#  frontend: "cd frontend && npm run lint"
#  docs: "make docs-lint"

# Files that should not be edited by agents
protected_files: []
#  - "*/migrations/*.py"
#  - "manage.py"

# Web UI + Hub daemon settings (cos web / cos hub).
# - web.port        port for the unified API + SPA.
# - web.autostart   start the per-project server on the next session start.
# - hub.enabled     register this project in the global hub at ~/.coding-os/.
# - hub.port        port the global hub listens on (default 9188).
web:
  port: 9188
  autostart: false

hub:
  enabled: true
  port: 9188
