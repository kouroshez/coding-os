{
  "pythonVersion": "3.10",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "src/core",
    "src/core/thinking_os",
    "src/core/graph_os",
    "src/core/board_os",
    "src/core/web"
  ],
  "include": [
    "src/cli",
    "src/core",
    "src/adapters",
    "scripts",
    "tests"
  ],
  "exclude": [
    ".venv",
    ".build",
    "**/__pycache__",
    "**/.coding-os",
    "**/.claude/worktrees"
  ],
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
